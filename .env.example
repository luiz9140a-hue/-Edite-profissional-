# Variáveis públicas/opcionais do SupremoBuild
# Não coloque senhas ou tokens reais neste arquivo.

# Obrigatória somente para geração com Gemini.
# Obtenha em: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=

# Opcional: o código usa um padrão quando não informado.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# VISUAL_GENERATION_MODE=on_request

# URL pública da aplicação, usada em links e callbacks.
# APP_URL=https://seu-dominio.exemplo

# Administração — o e-mail não é segredo; o UID deve vir do Firebase Authentication.
ADMIN_EMAILS=luiz9140a@gmail.com
VITE_ADMIN_EMAILS=luiz9140a@gmail.com
# ADMIN_UIDS=

# Pagamentos opcionais — configure somente quando Stripe estiver ativado.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Integrações opcionais. Não são necessárias para o Deploy via GitHub na Vercel.
# GITHUB_TOKEN=
# NETLIFY_AUTH_TOKEN=
# VERCEL_TOKEN=
