# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
VISUAL_GENERATION_MODE="on_request"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Account and product configuration. Never expose server secrets in VITE_ variables.
ADMIN_UIDS="firebase_uid_1,firebase_uid_2"
ADMIN_EMAILS="luiz9140a@gmail.com"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
VERCEL_TOKEN=""
NETLIFY_AUTH_TOKEN=""
GITHUB_TOKEN=""

# Public OAuth providers must also be enabled in Firebase Authentication.
VITE_ADMIN_EMAILS="luiz9140a@gmail.com"
