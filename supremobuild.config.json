{
  "mode": "SUPREME_BUILD",
  "principle": "entender o produto antes de gerar a tela",
  "defaultStack": {
    "frontend": "React 19 + TypeScript + Vite",
    "backend": "Node.js 22 + Express",
    "database": "Firestore-ready repository",
    "styling": "Tailwind CSS 4",
    "deploy": ["Vercel", "Netlify", "GitHub"]
  },
  "executors": [
    "product-architect", "ux-ui", "frontend", "backend", "data", "auth-security",
    "integrations", "visual-media", "qa-tests", "responsive", "performance", "deploy", "documentation"
  ],
  "rules": {
    "noFakeSuccess": true,
    "noPlaceholderImages": true,
    "noSecretsInFrontend": true,
    "alwaysBuildPreview": true,
    "alwaysRunQa": true,
    "alwaysPrepareExport": true,
    "responsiveMatrix": [320, 375, 390, 414, 768, 1024, 1280, 1440, 1920]
  },
  "command": "Modo SupremoBuild: entenda o pedido, escolha a arquitetura, execute todos os executores necessários, gere frontend/backend/dados, conecte integrações reais, teste, corrija, mostre o preview e entregue o projeto pronto para publicar."
}
